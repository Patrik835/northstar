# Northstar configuration.
#
# `make up` creates `.env` from this file and fills in the three secrets for you,
# so a local install needs no editing at all. Every other setting has a sensible
# default; see README.md → "Advanced configuration" only if you need to change one.

# --- Secrets (generated automatically by `make up`) --------------------------------
APP_SECRET_KEY=generate-me
CREDENTIAL_ENCRYPTION_KEY=generate-me
POSTGRES_PASSWORD=generate-me

# --- Where people open the app -----------------------------------------------------
# Use your public https:// address in production (secure cookies follow automatically).
PUBLIC_WEB_URL=http://localhost:8080
APP_ENV=development

# --- Email (optional) --------------------------------------------------------------
# Local default: mail is caught by Mailpit at http://localhost:8025.
# Leave SMTP_HOST empty to run without email: accounts are active immediately and
# password-reset emails are disabled. Fill in a real provider to send email.
SMTP_HOST=mailpit
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_START_TLS=true
# EMAIL_FROM_ADDRESS=northstar@example.com

# --- Optional features: paste a key to switch the feature on ------------------------
OPENAI_API_KEY=
FINNHUB_API_KEY=
ALPHA_VANTAGE_KEY=
