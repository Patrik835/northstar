# Runtime
APP_ENV=development
APP_SECRET_KEY=replace-with-at-least-32-random-characters
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-url-safe-base64-32-byte-key
DATABASE_URL=postgresql+asyncpg://investing:investing@db:5432/investing
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# Public self-service signup is the default product mode. Set false for invite/admin-only use.
PUBLIC_SIGNUP_ENABLED=true
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
PUBLIC_WEB_URL=http://localhost:8080

# Authentication abuse controls (database-backed, per rolling window)
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_ACCOUNT_LIMIT=10
AUTH_REGISTRATION_IP_LIMIT=5
AUTH_EMAIL_IP_LIMIT=10
AUTH_EMAIL_ACCOUNT_LIMIT=3

# Operations. Keep the metrics token secret; leave empty to disable /metrics.
LOG_FORMAT=json
MONITORING_TOKEN=
BACKUP_DIRECTORY=./backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
BACKUP_MAX_AGE_HOURS=30

# SMTP. Docker development defaults route mail to the local Mailpit inbox.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_START_TLS=false
SMTP_USE_TLS=false
EMAIL_FROM_ADDRESS=no-reply@northstar.local
EMAIL_FROM_NAME=Northstar

# Initial admin, created by the bootstrap command
INITIAL_ADMIN_USERNAME=patrik
INITIAL_ADMIN_PASSWORD=change-me-immediately

# External features
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
AI_REVIEW_CACHE_HOURS=12
AI_DAILY_REVIEW_LIMIT=3
AI_DAILY_MESSAGE_LIMIT=30
AI_MAX_INPUT_CHARACTERS=2000
NEWS_ENABLED=false
FINNHUB_API_KEY=
NEWS_BRIEF_CANDIDATE_LIMIT=300
ALPHA_VANTAGE_KEY=
BENCHMARKS_ENABLED=true

# Scheduling
SCHEDULER_ENABLED=true
NEWS_SYNC_HOUR_UTC=4
NOTIFICATION_DIGEST_HOUR_UTC=7
ALLOCATION_DRIFT_ALERT_POINTS=5
# Initial live-account target: refresh every 1–2 hours. Default to the lower-load end.
PORTFOLIO_SYNC_MINUTES=120
