# Runtime
APP_ENV=development
APP_SECRET_KEY=replace-with-at-least-32-random-characters
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-url-safe-base64-32-byte-key
DATABASE_URL=postgresql+asyncpg://investing:investing@db:5432/investing
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# Public self-service signup is the default product mode. Set false for invite/admin-only use.
PUBLIC_SIGNUP_ENABLED=true
EMAIL_VERIFICATION_TTL_HOURS=24
PUBLIC_WEB_URL=http://localhost:8080

# SMTP. Docker development defaults route mail to the local Mailpit inbox.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_START_TLS=false
SMTP_USE_TLS=false
EMAIL_FROM_ADDRESS=no-reply@northstar.local
EMAIL_FROM_NAME=Northstar

# Initial admin, created by the bootstrap command
INITIAL_ADMIN_USERNAME=patrik
INITIAL_ADMIN_PASSWORD=change-me-immediately

# External features
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
NEWS_ENABLED=false
FINNHUB_API_KEY=
ALPHA_VANTAGE_KEY=
BENCHMARKS_ENABLED=true

# Scheduling
SCHEDULER_ENABLED=true
# Initial live-account target: refresh every 1–2 hours. Default to the lower-load end.
PORTFOLIO_SYNC_MINUTES=120
NEWS_SYNC_HOUR_UTC=4
